{
  "name": "monkeycraft-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MonkeyCraft browser client, served from supported Fabric mod jars",
  "license": "CC0-1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "MONKEYCRAFT_PAGES=1 vite build && node tools/write-pages-provenance.mjs dist-pages",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "probe": "node tools/probe.ts",
    "record": "node tools/record-session.ts",
    "test:pages-provenance": "node --test tools/write-pages-provenance.test.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "jsqr": "^1.4.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  },
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.6"
  }
}
