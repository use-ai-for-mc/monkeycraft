+//export TsnetDiagnosticReset
+func TsnetDiagnosticReset() {
+	controlclient.MonkeycraftDiagnosticReset()
+}
+
+//export TsnetDiagnosticJSON
+func TsnetDiagnosticJSON(jsonOut **C.char) C.int {
+	if jsonOut == nil {
+		return C.EINVAL
+	}
+	*jsonOut = nil
+	data, err := controlclient.MonkeycraftDiagnosticJSON()
+	if err != nil {
+		return C.EIO
+	}
+	*jsonOut = C.CString(string(data))
+	if *jsonOut == nil {
+		return C.ENOMEM
+	}
+	return 0
+}
