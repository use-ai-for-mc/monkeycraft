diff --git a/control/controlclient/monkeycraft_diagnostics.go b/control/controlclient/monkeycraft_diagnostics.go
new file mode 100644
--- /dev/null
+++ b/control/controlclient/monkeycraft_diagnostics.go
@@ -0,0 +1,72 @@
+package controlclient
+
+import (
+	"encoding/json"
+	"sync"
+	"time"
+)
+
+const monkeycraftDiagnosticCapacity = 64
+
+type monkeycraftDiagnosticEvent struct {
+	Sequence  uint64 `json:"sequence"`
+	Stage     uint8  `json:"stage"`
+	ElapsedMS int64  `json:"elapsedMs"`
+	OffsetMS  int64  `json:"offsetMs"`
+	Attempt   uint64 `json:"attempt"`
+	Status    int    `json:"status"`
+}
+
+var monkeycraftDiagnostics struct {
+	mu       sync.Mutex
+	sequence uint64
+	attempt  uint64
+	epoch    time.Time
+	events   [monkeycraftDiagnosticCapacity]monkeycraftDiagnosticEvent
+	next     int
+	count    int
+}
+
+func monkeycraftDiagnosticRegisterAttempt() uint64 {
+	monkeycraftDiagnostics.mu.Lock()
+	defer monkeycraftDiagnostics.mu.Unlock()
+	monkeycraftDiagnostics.attempt++
+	return monkeycraftDiagnostics.attempt
+}
+
+func monkeycraftDiagnosticRegister(stage uint8, started time.Time, status int, attempt uint64) {
+	event := monkeycraftDiagnosticEvent{Stage: stage, ElapsedMS: time.Since(started).Milliseconds(), Attempt: attempt, Status: status}
+	monkeycraftDiagnostics.mu.Lock()
+	defer monkeycraftDiagnostics.mu.Unlock()
+	event.OffsetMS = time.Since(monkeycraftDiagnostics.epoch).Milliseconds()
+	monkeycraftDiagnostics.sequence++
+	event.Sequence = monkeycraftDiagnostics.sequence
+	monkeycraftDiagnostics.events[monkeycraftDiagnostics.next] = event
+	monkeycraftDiagnostics.next = (monkeycraftDiagnostics.next + 1) % monkeycraftDiagnosticCapacity
+	if monkeycraftDiagnostics.count < monkeycraftDiagnosticCapacity {
+		monkeycraftDiagnostics.count++
+	}
+}
+
+func MonkeycraftDiagnosticReset() {
+	monkeycraftDiagnostics.mu.Lock()
+	defer monkeycraftDiagnostics.mu.Unlock()
+	monkeycraftDiagnostics.sequence = 0
+	monkeycraftDiagnostics.attempt = 0
+	monkeycraftDiagnostics.epoch = time.Now()
+	monkeycraftDiagnostics.next = 0
+	monkeycraftDiagnostics.count = 0
+}
+
+func MonkeycraftDiagnosticJSON() ([]byte, error) {
+	monkeycraftDiagnostics.mu.Lock()
+	events := make([]monkeycraftDiagnosticEvent, monkeycraftDiagnostics.count)
+	start := (monkeycraftDiagnostics.next - monkeycraftDiagnostics.count + monkeycraftDiagnosticCapacity) % monkeycraftDiagnosticCapacity
+	for i := range events {
+		events[i] = monkeycraftDiagnostics.events[(start+i)%monkeycraftDiagnosticCapacity]
+	}
+	monkeycraftDiagnostics.mu.Unlock()
+	return json.Marshal(struct {
+		Events []monkeycraftDiagnosticEvent `json:"events"`
+	}{Events: events})
+}
diff --git a/control/controlclient/monkeycraft_diagnostics_test.go b/control/controlclient/monkeycraft_diagnostics_test.go
new file mode 100644
--- /dev/null
+++ b/control/controlclient/monkeycraft_diagnostics_test.go
@@ -0,0 +1,48 @@
+package controlclient
+
+import (
+	"encoding/json"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestMonkeycraftDiagnosticBoundedConcurrentReset(t *testing.T) {
+	MonkeycraftDiagnosticReset()
+	var wg sync.WaitGroup
+	for i := 0; i < monkeycraftDiagnosticCapacity*2; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			attempt := monkeycraftDiagnosticRegisterAttempt()
+			monkeycraftDiagnosticRegister(uint8((i%4)+1), time.Now(), i, attempt)
+		}(i)
+	}
+	wg.Wait()
+	data, err := MonkeycraftDiagnosticJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var snapshot struct {
+		Events []monkeycraftDiagnosticEvent `json:"events"`
+	}
+	if err := json.Unmarshal(data, &snapshot); err != nil {
+		t.Fatal(err)
+	}
+	if len(snapshot.Events) != monkeycraftDiagnosticCapacity {
+		t.Fatalf("events=%d", len(snapshot.Events))
+	}
+	for i, event := range snapshot.Events {
+		if event.Sequence != uint64(i+monkeycraftDiagnosticCapacity+1) {
+			t.Fatalf("sequence=%d at %d", event.Sequence, i)
+		}
+	}
+	MonkeycraftDiagnosticReset()
+	data, err = MonkeycraftDiagnosticJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != `{"events":[]}` {
+		t.Fatalf("reset=%s", data)
+	}
+}
