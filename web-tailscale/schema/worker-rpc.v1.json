{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkeycraft.dev/web-tailscale/schema/worker-rpc.v1.json",
  "title": "MonkeyCraft Tailscale Worker RPC v1",
  "description": "Versioned messages between the page and a Dedicated Worker. Binary payloads travel as transferable ArrayBuffers in a sibling postMessage field, never as JSON strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "kind"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "kind": {
      "type": "string",
      "enum": ["req", "res", "evt", "bin"]
    },
    "id": {
      "type": "string",
      "description": "Request/response correlation id. Required for req/res. UUID or monotonic string."
    },
    "eventId": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic event id on evt messages."
    },
    "method": {
      "type": "string",
      "enum": [
        "hello",
        "init",
        "login",
        "logout",
        "status",
        "dialTcp",
        "connRead",
        "connWrite",
        "connClose",
        "wsOpen",
        "wsSend",
        "wsClose",
        "shutdown"
      ]
    },
    "ok": { "type": "boolean" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PROTOCOL",
            "UNSUPPORTED",
            "NOT_RUNNING",
            "NEEDS_LOGIN",
            "NEEDS_APPROVAL",
            "CANCELLED",
            "TIMEOUT",
            "QUEUE_FULL",
            "CONN_LIMIT",
            "INVALID_TARGET",
            "CLOSED",
            "WORKER_CRASH",
            "WASM_LOAD",
            "WSS_BLOCKED",
            "INTERNAL"
          ]
        },
        "message": { "type": "string", "maxLength": 200 }
      }
    },
    "payload": { "type": "object" }
  }
}
