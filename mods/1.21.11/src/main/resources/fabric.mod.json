{
	"schemaVersion": 1,
	"id": "monkeycraft",
	"version": "${version}",
	"name": "MonkeyCraft",
	"description": "Stream and control your Minecraft game from your phone. Live H.264 video, touch controls, chat, and notifications from anywhere.",
	"authors": [
		"weikengchen"
	],
	"contact": {
		"homepage": "https://github.com/weikengchen/monkeycraft",
		"sources": "https://github.com/weikengchen/monkeycraft",
		"issues": "https://github.com/weikengchen/monkeycraft/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/monkeycraft/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.chenweikeng.monkeycraft.MonkeycraftClient"
		],
		"modmenu": [
			"com.chenweikeng.monkeycraft.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"monkeycraft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
