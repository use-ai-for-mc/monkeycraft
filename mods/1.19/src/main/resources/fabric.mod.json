{
	"schemaVersion": 1,
	"id": "monkeycraft",
	"version": "${version}",
	"name": "MonkeyCraft",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/monkeycraft/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.chenweikeng.monkeycraft.MonkeycraftClient"
		],
		"modmenu": [
			"com.chenweikeng.monkeycraft.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"monkeycraft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "~1.19",
		"java": ">=17",
		"fabric": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
